{
  "name": "aom-datacenter",
  "version": "0.7.0",
  "description": "机房数字孪生与运维系统",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "npm run test:unit && npm run build && playwright test",
    "test": "go test ./...",
    "release": "bash scripts/build.sh",
    "test:unit": "node --test tests/*.test.mjs"
  },
  "type": "module",
  "dependencies": {
    "elkjs": "^0.12.1",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "1.56",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vue-tsc": "^3.3.13"
  },
  "private": true
}
